# Maintainer: Nielson Rolim <nielsonrolim@users.noreply.github.com>
# The OBS package (home:nielsonrolim, repository Arch). packaging/make-source.sh makes the source tarball
# of a commit and this file with its sha256; to build by hand, run it and then makepkg in its output folder.
pkgname=pacu
pkgver=0.1.1
pkgrel=1
pkgdesc="A small package-management wrapper around an AUR helper (paru, yay or pikaur) and pacman for Arch and derivatives"
arch=(x86_64 aarch64)
url="https://github.com/nielsonrolim/pacu"
license=(Apache-2.0)
# 0.1.0 was published as paku: pacman -Syu replaces it with pacu
replaces=(paku)
conflicts=(paku)
provides=("paku=$pkgver")
# libgcc and glibc: what the binary links (namcap); pacman: what it runs
depends=(glibc libgcc pacman)
makedepends=(cargo)
optdepends=('paru: AUR packages (search, install, upgrade), the first helper pacu looks for'
            'yay: AUR packages, when paru is missing or with helper = yay'
            'pikaur: AUR packages, when paru and yay are missing or with helper = pikaur'
            'sudo: install, remove and upgrade without an AUR helper'
            'flatpak: pacu upgrade also upgrades the Flatpaks'
            'cachy-update: pacu maintain and pacu check'
            'curl: pacu aur-audit'
            'pacman-contrib: pacu check without an AUR helper (checkupdates)')
source=("$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # The OBS builds without network: the tarball brings the crates in vendor/ when there are any
  [[ -d vendor ]] && return
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  local pacu=target/release/pacu
  install -Dm755 "$pacu" "$pkgdir/usr/bin/pacu"
  install -Dm644 pacu.1 "$pkgdir/usr/share/man/man1/pacu.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions" \
    "$pkgdir/usr/share/fish/vendor_completions.d"
  "$pacu" completions bash > "$pkgdir/usr/share/bash-completion/completions/pacu"
  "$pacu" completions zsh > "$pkgdir/usr/share/zsh/site-functions/_pacu"
  "$pacu" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/pacu.fish"
}
